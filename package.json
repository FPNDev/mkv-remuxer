{
  "name": "@rimjoeh/mkv-remuxer",
  "version": "0.1.1",
  "description": "Remux Matroska and WebM files into HLS (fMP4 and WebVTT) on demand from any random-access byte source",
  "keywords": [
    "matroska",
    "mkv",
    "webm",
    "hls",
    "fmp4",
    "remux",
    "ffmpeg"
  ],
  "homepage": "https://github.com/FPNDev/mkv-remuxer#readme",
  "bugs": {
    "url": "https://github.com/FPNDev/mkv-remuxer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FPNDev/mkv-remuxer.git"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "directories": {
    "example": "examples"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
